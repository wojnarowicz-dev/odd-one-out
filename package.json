{
  "name": "odd-one-out",
  "version": "0.2.1",
  "description": "Finds places that deviate from the convention of the project itself: N times this way, once differently. Java, JavaScript, TypeScript, Maven pom.xml, SQL migrations on Supabase.",
  "license": "MIT",
  "author": "Aleksander Wojnarowicz",
  "type": "module",
  "bin": {
    "odd-one-out": "bin/odd-one-out.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "README.pl.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wojnarowicz-dev/odd-one-out.git"
  },
  "homepage": "https://github.com/wojnarowicz-dev/odd-one-out#readme",
  "bugs": {
    "url": "https://github.com/wojnarowicz-dev/odd-one-out/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/odd-one-out.mjs",
    "self-check": "node bin/odd-one-out.mjs js . --json .odd-one-out/self-js.json && node bin/odd-one-out.mjs deps . --json .odd-one-out/self-deps.json",
    "smoke": "node src/smoke.mjs test/Smoke.java",
    "plugin:validate": "claude plugin validate . --strict",
    "known-answers": "node test/known-answers.mjs",
    "golden": "node test/golden.mjs",
    "sql-types": "node test/sql-types.mjs",
    "test": "node test/golden.mjs && node test/sql-types.mjs && node test/resilience.mjs && node test/lang-check.mjs && node test/readme-check.mjs",
    "resilience": "node test/resilience.mjs",
    "lang-check": "node test/lang-check.mjs",
    "foreign": "node test/foreign.mjs",
    "amplify": "node test/amplify.mjs",
    "mutation": "node test/mutation.mjs",
    "full": "npm test && node test/amplify.mjs && node test/mutation.mjs",
    "readme-check": "node test/readme-check.mjs"
  },
  "keywords": [
    "static-analysis",
    "anomaly-detection",
    "pr-miner",
    "convention",
    "java",
    "javascript",
    "typescript",
    "sql",
    "migrations",
    "supabase",
    "maven",
    "tree-sitter"
  ],
  "dependencies": {
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.0"
  }
}
